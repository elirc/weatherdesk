# ── Core ────────────────────────────────────────────────────────────────
# postgres connection (PostGIS + pg_trgm required; compose provides both)
DATABASE_URL=postgres://postgres:postgres@localhost:5440/weatherdesk_dev
# separate db for vitest integration suites
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5440/weatherdesk_test
# web origin, used for absolute links in emails/reports/widget embeds
APP_URL=http://localhost:3000
NODE_ENV=development

# ── Mode ────────────────────────────────────────────────────────────────
# "mock" = every provider adapter returns deterministic fixtures, zero external calls.
# "real" = live providers. Individual adapters can be overridden below.
WD_MODE=mock
# Dev/e2e only: instant sign-in as seeded users. The app REFUSES to start
# in production when this is set.
AUTH_MOCK=false

# ── Auth (Better Auth) ──────────────────────────────────────────────────
BETTER_AUTH_SECRET=dev-secret-change-me-32-chars-min!!
BETTER_AUTH_URL=http://localhost:3000

# ── Providers (only needed when the adapter runs in real mode) ─────────
# forecast: open-meteo | google  (mock in WD_MODE=mock)
FORECAST_PROVIDER=open-meteo
# paid plan key; free tier (no key) is non-commercial only
OPEN_METEO_API_KEY=
GOOGLE_WEATHER_API_KEY=
# history: NASA POWER needs no key.
# SMS / WhatsApp
TERMII_API_KEY=
TERMII_SENDER_ID=WeatherDesk
# Email
RESEND_API_KEY=
EMAIL_FROM=reports@weatherdesk.example
# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Per-adapter override: mock | real (defaults to WD_MODE)
ADAPTER_FORECAST=
ADAPTER_HISTORY=
ADAPTER_SMS=
ADAPTER_EMAIL=
ADAPTER_PAYMENTS=
ADAPTER_STORAGE=

# ── Storage ─────────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=weatherdesk
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Map ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Worker ──────────────────────────────────────────────────────────────
# pg-boss uses DATABASE_URL. Budget guard: max provider calls per month.
PROVIDER_CALL_BUDGET_MONTHLY=1000000
